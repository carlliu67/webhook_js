# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要提交真实密钥

# 服务监听端口（容器内端口，宿主机映射见 docker-compose.yml）
PORT=2306
# 监听地址，容器内保持 0.0.0.0
HOST=0.0.0.0

# 腾讯会议 Webhook 回调 Token
WEMEET_WEBHOOK_TOKEN=
# 腾讯会议 Webhook 回调 AES 密钥（EncodingAESKey）
WEMEET_WEBHOOK_AES_KEY=

# Webhook 回调路径
WEBHOOK_PATH=/webhook

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# ---- 仅用于镜像构建的大陆镜像源（.env 变化时会自动触发重建）----
# 基础镜像，拉取不到 node:20-alpine 时改为镜像站地址，例如：
# docker.m.daocloud.io/node:20-alpine
# swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/node:20-alpine
BASE_IMAGE=node:20-alpine
# apk 源：阿里云 / 中科大 / 腾讯
APK_MIRROR=https://mirrors.aliyun.com
# npm 源
NPM_REGISTRY=https://registry.npmmirror.com
